# Tunel automatico gratis (Cloudflare trycloudflare + registro GitHub Gist)
# Menú por sede: confirma Portoviejo o Chone en Conectividad (o usa BARRIL_BRANCH_SITE_ID)

BARRIL_AUTO_START_TUNNEL=1
# BARRIL_BRANCH_SITE_ID=portoviejo
# BARRIL_BRANCH_SITE_ID=chone

# Registro gratis de URLs (mismo gist en las dos laptops)
GITHUB_TUNNEL_GIST_ID=
GITHUB_TUNNEL_GIST_TOKEN=
TUNNEL_REGISTRY_PUBLIC_URL=

# Opcional: solo si algun dia compras dominio fijo
# BARRIL_PUBLIC_URL=https://portoviejo.tudominio.com
# CLOUDFLARE_TUNNEL_TOKEN=
