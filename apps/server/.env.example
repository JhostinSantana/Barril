# Sede de ESTA laptop (obligatorio en cada equipo)
# portoviejo = Barril Portoviejo
# chone = Barril Chone
BARRIL_BRANCH_SITE_ID=portoviejo

# URL publica fija (HTTPS, sin barra final). Obligatoria para que el link no cambie al reiniciar.
# Sin esto, Cloudflare entrega una URL temporal distinta en cada arranque.
BARRIL_PUBLIC_URL=https://portoviejo.tudominio.com

# Token del tunel con nombre en Cloudflare Zero Trust
CLOUDFLARE_TUNNEL_TOKEN=

# Tunel al arrancar el servidor (1 = si, 0 = no). Por defecto: 1
BARRIL_AUTO_START_TUNNEL=1

# Espera antes de abrir el tunel (ms). La laptop carga primero; por defecto 4000
BARRIL_TUNNEL_START_DELAY_MS=4000
